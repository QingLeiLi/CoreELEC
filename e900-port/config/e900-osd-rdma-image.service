[Unit]
Description=Restore source-audited E900 OSD boot trigger
After=graphical.target
Before=kodi.service
ConditionKernelCommandLine=amvideo.gxlx2_hw_init_wait=0
ConditionPathExists=!/storage/.config/e900-osd-rdma.disable

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/e900-boot/e900-osd-rdma-boot.py
RemainAfterExit=yes
TimeoutStartSec=10
