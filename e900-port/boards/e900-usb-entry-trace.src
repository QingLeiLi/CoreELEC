echo "E900 ARM64 entry trace; RAM only, no persistent environment writes"
setenv e9_saved_bootargs "${bootargs}"
if setexpr.l e9_stage *0x074ff000; then
  if test "${e9_stage}" = "e9000001"; then
    setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_entry=reached"
  else
    if test "${e9_stage}" = "e9000000"; then
      setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_entry=not_observed"
    else
      usb start
      if fatload usb 0:1 0x11000000 e900-Image-trace; then
        if fatload usb 0:1 0x15000000 e900-uInitrd; then
          if fatload usb 0:1 0x18000000 e900-trace.dtb; then
            if fatload usb 0:1 0x074ff000 E9ARM.BIN; then
              if setexpr.l e9_stage *0x074ff000; then
                if test "${e9_stage}" = "e9000000"; then
                  setenv bootargs "boot=LABEL=COREELEC disk=LABEL=STORAGE console=ttyS0,115200 console=tty0 no_console_suspend vout=1080p60hz,en logo=osd0,loaded,0x3dc00000 frac_rate_policy=0 hdr_policy=1 ssh panic=0 loglevel=8 ignore_loglevel"
                  booti 0x11000000 0x15000000 0x18000000
                  setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_booti=returned"
                else
                  setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=readback_failed"
                fi
              else
                setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=read_failed"
              fi
            else
              setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=arm_load_failed"
            fi
          else
            setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=dtb_load_failed"
          fi
        else
          setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=initrd_load_failed"
        fi
      else
        setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=image_load_failed"
      fi
    fi
  fi
else
  setenv bootargs "${e9_saved_bootargs} e9probe=entry04 e9_trace=setexpr_unavailable"
fi
echo "E900 entry trace returned to the existing Android boot command"
