/* Experimental E900V21C 5800-2ATA411, GXLX2, 1GB. USB boot only. */
#include "gxl_p212_1g.dts"

/ {
	model = "Skyworth E900V21C (GXLX2, experimental USB)";
	/* Keep the legacy spelling used by CoreELEC's Mali-450 library selector. */
	compatible = "skyworth,e900v21c", "amlogic,gxlx2", "amlogic, Gxl";
	amlogic-dt-id = "gxlx2_p291_1g";
	coreelec-dt-id = "gxlx2_p291_1g_e900v21c";

	cpu_ver_name {
		compatible = "amlogic, cpu-major-id-gxlx2";
	};

	reserved-memory {
		/* Preserve the old Android boot firmware's fixed secure carveout.
		 * Keep CE's separate secmon CMA pool: its driver allocates 3MiB there.
		 */
		firmware_secmon@10000000 {
			reg = <0x0 0x10000000 0x0 0x00200000>;
			no-map;
		};

		/* The old boot firmware uses 0x3dc00000 for its framebuffer. */
		linux,meson-fb {
			/delete-property/ size;
			/delete-property/ alignment;
			/delete-property/ alloc-ranges;
			reg = <0x0 0x3dc00000 0x0 0x02400000>;
		};
	};

	meson-fb {
		logo_addr = "0x3dc00000";
	};

	/* Board GPIO peripherals are deliberately outside the first USB test. */
	gpioleds { status = "disabled"; };
	gpio_keypad { status = "disabled"; };
	openvfd { status = "disabled"; };
	/* P291 reference DT; old unit's Android log confirms X6/X7 and HIGH IRQ.
	 * Runtime chip 0x56630001 uses UWE5621 SDIO, not Broadcom buffers.
	 * Keep the reference 32k pinmux, without P212's unverified PWM programming.
	 */
	wifi {
		status = "okay";
		interrupt_pin = <&gpio GPIOX_7 GPIO_ACTIVE_HIGH>;
		irq_trigger_type = "GPIO_IRQ_HIGH";
		power_on_pin = <&gpio GPIOX_6 GPIO_ACTIVE_HIGH>;
		/delete-property/ dhd_static_buf;
		/delete-property/ pwm_config;
	};
	bt-dev {
		status = "okay";
		gpio_reset = <&gpio GPIOX_17 GPIO_ACTIVE_HIGH>;
		/* P291 has no dedicated host-wake GPIO. SDIO carries BT traffic. */
		/delete-property/ gpio_btwakeup;
	};
};

&usb2_phy {
	portnum = <2>;
};

&usb3_phy {
	portnum = <0>;
};

/* Keep internal eMMC untouched; enable the removable TF/SD slot. */
&sd_emmc_c { status = "disabled"; };
/* P291: CARD_0..5 bus, CARD_6 card detect, 3.3V SD high-speed. */
&sd_emmc_b { status = "okay"; };
&sd_emmc_a {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	/* Match CE's Unisoc udev rule and the sprdwl OF driver. */
	wifi@1 {
		reg = <1>;
		compatible = "sprd,unisoc-wifi";
	};
};

&amhdmitx {
	/* GXL PHY/clock profile, separate direct DWC/TOP register transport. */
	ic_type = <3>;
	amlogic,gxlx2-direct-hdmi;
};

&ethmac {
	internal_phy = <1>;
	phy-mode = "rmii";
	mc_val_internal_phy = <0x1800>;
	/* No external PHY reset or strap GPIOs on this board. */
	/delete-property/ rst_pin-gpios;
	/delete-property/ GPIOZ4_pin-gpios;
	/delete-property/ GPIOZ5_pin-gpios;
	/* Internal RMII needs no external RGMII pin mux. */
	pinctrl-names = "internal_eth_pins";
	pinctrl-0 = <>;
};

/* Original P291 Android DT exposes PP0 and PP1 only. Accessing PP2's MMU
 * at 0xd00c6004 caused a synchronous external abort on this hardware.
 */
&gpu {
	num_of_pp = <2>;
	sc_mpp = <2>;
	pmu_domain_config = <1 2 4 0 0 0 0 0 0 1 2 0>;
	interrupts = <0 160 4>, <0 161 4>, <0 162 4>, <0 163 4>,
		     <0 164 4>, <0 165 4>, <0 166 4>, <0 167 4>;
	interrupt-names = "IRQGP", "IRQGPMMU", "IRQPP", "IRQPMU",
			  "IRQPP0", "IRQPPMMU0", "IRQPP1", "IRQPPMMU1";
};
