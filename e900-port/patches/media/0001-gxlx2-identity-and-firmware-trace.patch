diff --git a/drivers/common/firmware/firmware_drv.c b/drivers/common/firmware/firmware_drv.c
--- a/drivers/common/firmware/firmware_drv.c
+++ b/drivers/common/firmware/firmware_drv.c
@@ -81,6 +81,15 @@
 static u32 debug;
 static u32 detail;
 
+/* Trace actual selections, without changing microcode compatibility policy. */
+static void trace_gxlx2_firmware(const struct fw_info_s *info)
+{
+	if (get_cpu_major_id() == AM_MESON_CPU_MAJOR_ID_GXLX2)
+		pr_info("e900-gxlx2: firmware format=%u name=%s cpu=%s source=%s\n",
+			info->format, info->name, info->data->head.cpu,
+			info->src_from);
+}
+
 int get_firmware_data(unsigned int format, char *buf)
 {
 	int data_len, ret = -1;
@@ -109,6 +118,7 @@
 		if (format != info->format)
 			continue;
 
+		trace_gxlx2_firmware(info);
 		data_len = info->data->head.data_size;
 		memcpy(buf, info->data->data, data_len);
 		ret = data_len;
@@ -150,6 +160,7 @@
 		if (strcmp(fw_name, info->name))
 			continue;
 
+		trace_gxlx2_firmware(info);
 		data_len = info->data->head.data_size;
