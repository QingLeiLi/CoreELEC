+#include <linux/string.h>
 #include <linux/amlogic/media/vout/hdmi_tx/hdmi_tx_module.h>
 #include <linux/arm-smccc.h>
 #include "common.h"
@@ -257,6 +258,9 @@
 	}
 };
 
+/* GXL buses/PHY, but separate direct DWC and TOP register windows. */
+static struct reg_map reg_maps_gxlx2[ARRAY_SIZE(reg_maps_def)];
+
 struct reg_map *map;
 
 void init_reg_map(unsigned int type)
@@ -281,6 +285,14 @@
 	default:
 		map = reg_maps_def;
 		break;
+	}
+	if (get_hdmitx_device()->gxlx2_direct_hdmi) {
+		memcpy(reg_maps_gxlx2, reg_maps_def, sizeof(reg_maps_def));
+		reg_maps_gxlx2[HDMITX_SEC_REG_IDX].phy_addr = 0xda800000;
+		reg_maps_gxlx2[HDMITX_SEC_REG_IDX].size = 0x8000;
+		reg_maps_gxlx2[HDMITX_REG_IDX].phy_addr = 0xda808000;
+		reg_maps_gxlx2[HDMITX_REG_IDX].size = 0x4000;
+		map = reg_maps_gxlx2;
 	}
 	for (i = 0; map[i].phy_addr != REG_ADDR_END; i++) {
 		/* ANACTRL_REG_IDX is new added in SC2,
@@ -576,7 +588,7 @@
 	unsigned int data;
 	struct hdmitx_dev *hdev = get_hdmitx_device();
 
-	if (hdev->chip_type >= MESON_CPU_ID_G12A)
+	if (hdev->gxlx2_direct_hdmi || hdev->chip_type >= MESON_CPU_ID_G12A)
 		data = hdmitx_rd_reg_g12a(addr);
 	else if (hdev->chip_type == MESON_CPU_ID_GXL)
 		data = hdmitx_rd_reg_old(addr);
@@ -669,7 +681,7 @@
 {
 	struct hdmitx_dev *hdev = get_hdmitx_device();
 
-	if (hdev->chip_type >= MESON_CPU_ID_G12A)
+	if (hdev->gxlx2_direct_hdmi || hdev->chip_type >= MESON_CPU_ID_G12A)
 		hdmitx_wr_reg_g12a(addr, data);
 	else if (hdev->chip_type == MESON_CPU_ID_GXL)
 		hdmitx_wr_reg_old(addr, data);
