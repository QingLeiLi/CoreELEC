Subject: [EXPERIMENTAL] add opt-in GXLX2 direct register transport, preserve GXL PHY

Base revisions are fixed in pins.json. Not hardware validated.

diff --git a/include/linux/amlogic/media/vout/hdmi_tx/hdmi_tx_module.h b/include/linux/amlogic/media/vout/hdmi_tx/hdmi_tx_module.h
--- a/include/linux/amlogic/media/vout/hdmi_tx/hdmi_tx_module.h
+++ b/include/linux/amlogic/media/vout/hdmi_tx/hdmi_tx_module.h
@@ -335,6 +335,8 @@
 #endif
 	struct timer_list hdcp_timer;
 	int chip_type;
+	/* Experimental direct HDMI access with the existing GXL PHY profile. */
+	bool gxlx2_direct_hdmi;
 	int hdmi_init;
 	int hpdmode;
 	/* -1, no hdcp; 0, NULL; 1, 1.4; 2, 2.2 */
diff --git a/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hdmi_tx_main.c b/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hdmi_tx_main.c
--- a/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hdmi_tx_main.c
+++ b/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hdmi_tx_main.c
@@ -6871,6 +6871,8 @@
 		/* Get ic type information */
 		ret = of_property_read_u32(pdev->dev.of_node, "ic_type",
 			&(hdmitx_device.chip_type));
+		hdmitx_device.gxlx2_direct_hdmi = of_property_read_bool(
+			pdev->dev.of_node, "amlogic,gxlx2-direct-hdmi");
 
 		/* Get dongle_mode information */
 		ret = of_property_read_u32(pdev->dev.of_node, "dongle_mode",
@@ -7002,6 +7004,14 @@
 	amhdmitx_device_init(&hdmitx_device);
 
 	ret = amhdmitx_get_dt_info(pdev);
+	if (hdmitx_device.gxlx2_direct_hdmi) {
+		if (!is_meson_gxlx2_cpu() ||
+		    hdmitx_device.chip_type != MESON_CPU_ID_GXL) {
+			dev_err(&pdev->dev, "GXLX2 direct HDMI requires SoC 0x2a and ic_type 3\n");
+			return -EINVAL;
+		}
+		dev_warn(&pdev->dev, "experimental GXLX2 HDMI register transport; GXL PHY retained\n");
+	}
 
 	amhdmitx_clktree_probe(&(pdev->dev));
 
diff --git a/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hw/reg_ops.c b/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hw/reg_ops.c
--- a/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hw/reg_ops.c
+++ b/drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hw/reg_ops.c
