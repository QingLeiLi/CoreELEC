Subject: [EXPERIMENTAL] publish verified GXLX2 media buses after device init

Early registration prevents boot; blacklisting it plus runtime registration
works. Diagnostic75 also boots when the unchanged native registration function
runs after the final existing late initcall, without blacklist or helper.
This source candidate uses late_initcall_sync for GXLX2 only. Its exact linked
position and full ARM build still require hardware regression.

diff --git a/drivers/amlogic/media/common/arch/registers/register_ops_m8.c b/drivers/amlogic/media/common/arch/registers/register_ops_m8.c
--- a/drivers/amlogic/media/common/arch/registers/register_ops_m8.c
+++ b/drivers/amlogic/media/common/arch/registers/register_ops_m8.c
@@ -15,6 +15,7 @@
  *
  */
 
+#include <linux/init.h>
 #include <linux/amlogic/media/registers/register_ops.h>
 #include <linux/amlogic/media/registers/register_map.h>
 #include <linux/amlogic/media/utils/log.h>
@@ -78,6 +79,20 @@
 	{IO_DMC_BUS, 0, codecio_read_dmcbus, codecio_write_dmcbus},
 };
 
+/* GXLX2 numeric ID falls outside both legacy registration lists.
+ * Register only the direct buses verified on P291; parser/AIU/demux/reset
+ * offsets still require a separate hardware audit and are not guessed here.
+ */
+static struct chip_register_ops gxlx2_ops[] __initdata = {
+	{IO_DOS_BUS, 0, codecio_read_dosbus, codecio_write_dosbus},
+	{IO_AO_BUS, 0, codecio_read_aobus, codecio_write_aobus},
+	{IO_HHI_BUS, -0x1000, codecio_read_hiubus, codecio_write_hiubus},
+	{IO_C_BUS, 0, codecio_read_cbus, codecio_write_cbus},
+	{IO_VC_BUS, 0, codecio_read_vcbus, codecio_write_vcbus},
+	{IO_VPP_BUS, 0, codecio_read_vcbus, codecio_write_vcbus},
+	{IO_DMC_BUS, 0, codecio_read_dmcbus, codecio_write_dmcbus},
+};
+
 static int __init vdec_reg_ops_init(void)
 {
 	int cpus[] = REGISTER_FOR_CPU;
@@ -129,6 +144,10 @@
 		}
 	}
 
+	/* Early publication enables unsafe GXLX2 accesses during device init. */
+	if (is_meson_gxlx2_cpu())
+		return 0;
+
 	register_reg_ops_mgr(cpus, m8_ops,
 		sizeof(m8_ops) / sizeof(struct chip_register_ops));
 
@@ -139,3 +158,16 @@
 }
 
 postcore_initcall(vdec_reg_ops_init);
+
+/* GXLX2 boots with the same seven callbacks published after device init.
+ * Other SoCs keep their original postcore registration and bus tables.
+ * Keep this table in __initdata: late initcalls run before free_initmem().
+ */
+static int __init gxlx2_reg_ops_late_init(void)
+{
+	if (!is_meson_gxlx2_cpu())
+		return 0;
+	return register_reg_ops_per_cpu(MESON_CPU_MAJOR_ID_GXLX2,
+		gxlx2_ops, ARRAY_SIZE(gxlx2_ops));
+}
+late_initcall_sync(gxlx2_reg_ops_late_init);
