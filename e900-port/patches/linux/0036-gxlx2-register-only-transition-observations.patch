+/* Separate extension avoids overflowing PAGE_SIZE or changing legacy rows.
+ * Only frozen mode2 exports this data. No hardware reads in sysfs getters.
+ */
+static int e900_edge_regs_get(char *buf, const struct kernel_param *kp)
+{
+ unsigned int i, j, begin; unsigned long flags; int n = 0; (void)kp;
+ spin_lock_irqsave(&e900_pixel_lock, flags);
+ if (!e900_edge_register_only) { n = -EINVAL; goto out; }
+ if (e900_edge_status == 1 || e900_edge_status == 2) { n = -EBUSY; goto out; }
+ begin = READ_ONCE(e900_edge_page) * E900_EDGE_PAGE;
+ for (i = begin; i < e900_edge_count && i < begin + E900_EDGE_PAGE; i++) {
+  const struct e900_edge_record *r = &e900_edge_records[i];
+  n += scnprintf(buf + n, PAGE_SIZE - n, "%u %u %llx %x %x %x",
+   i, e900_edge_generation, (unsigned long long)r->stamp,
+   r->tick, r->phase, r->flags);
+  for (j = 0; j < E900_EDGE_REG_WORDS; j++)
+   n += scnprintf(buf + n, PAGE_SIZE - n, " %x", r->registers[j]);
+  n += scnprintf(buf + n, PAGE_SIZE - n, "\n");
+ }
+out:
+ spin_unlock_irqrestore(&e900_pixel_lock, flags); return n;
+}
+static const struct kernel_param_ops e900_edge_regs_ops = { .get = e900_edge_regs_get };
+module_param_cb(gxlx2_edge_regs, &e900_edge_regs_ops, NULL, 0400);
