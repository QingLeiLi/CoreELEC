+static struct vframe_s fake_vframe;
+/* Opt-in, one recovery per observed global-output off/on within one provider session. */
+static bool gxlx2_hdr_recovery;
+static DEFINE_SPINLOCK(e900_hdr_lock);
+static bool e900_hdr_saw_off, e900_hdr_pending;
+static u32 e900_hdr_session, e900_hdr_generation;
+static int e900_hdr_mode;
+static unsigned long e900_hdr_deadline;
+static unsigned int e900_hdr_requests, e900_hdr_consumed;
+static unsigned int e900_hdr_cancelled, e900_hdr_post_calls;
+static atomic_t e900_hdr_logs = ATOMIC_INIT(0);
+
+static void e900_hdr_log(const char *event, u32 generation)
+{
+	if (atomic_inc_return(&e900_hdr_logs) <= 16)
+		pr_info("e900-hdr-recovery %s generation=%u request=%u consumed=%u cancel=%u post=%u\n",
+			event, generation, READ_ONCE(e900_hdr_requests),
+			READ_ONCE(e900_hdr_consumed), READ_ONCE(e900_hdr_cancelled),
+			READ_ONCE(e900_hdr_post_calls));
+}
+
+static void e900_hdr_clear_locked(void)
+{
+	if (e900_hdr_saw_off || e900_hdr_pending)
+		e900_hdr_cancelled++;
+	e900_hdr_saw_off = false;
+	e900_hdr_pending = false;
+}
+
+void e900_hdr_recovery_cancel(void)
+{
+	unsigned long irqflags;
+	bool had_state;
+	u32 generation;
+
+	spin_lock_irqsave(&e900_hdr_lock, irqflags);
+	had_state = e900_hdr_saw_off || e900_hdr_pending;
+	generation = e900_hdr_generation;
+	e900_hdr_clear_locked();
+	spin_unlock_irqrestore(&e900_hdr_lock, irqflags);
+	if (had_state)
+		e900_hdr_log("cancel", generation);
+}
+EXPORT_SYMBOL(e900_hdr_recovery_cancel);
+
+static int e900_hdr_enable_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (!ret && !READ_ONCE(gxlx2_hdr_recovery))
+		e900_hdr_recovery_cancel();
+	return ret;
+}
+static const struct kernel_param_ops e900_hdr_enable_ops = {
+	.set = e900_hdr_enable_set,
+	.get = param_get_bool,
+};
+module_param_cb(gxlx2_hdr_recovery, &e900_hdr_enable_ops,
+		&gxlx2_hdr_recovery, 0600);
+MODULE_PARM_DESC(gxlx2_hdr_recovery,
+	"Opt-in GXLX2 VD1 one-shot HDR reconfiguration after global-output recovery");
+module_param_named(gxlx2_hdr_recovery_requests, e900_hdr_requests, uint, 0444);
+module_param_named(gxlx2_hdr_recovery_consumed, e900_hdr_consumed, uint, 0444);
+module_param_named(gxlx2_hdr_recovery_cancelled, e900_hdr_cancelled, uint, 0444);
+module_param_named(gxlx2_hdr_recovery_post_calls, e900_hdr_post_calls, uint, 0444);
+
+void e900_hdr_recovery_edge(bool old_output, bool new_output,
+			    bool active_frame, u32 session, int mode)
+{
+	unsigned long irqflags;
+	bool requested = false, cancelled = false;
+	u32 generation;
+
+	if (!is_meson_gxlx2_cpu() || !READ_ONCE(gxlx2_hdr_recovery) ||
+	    old_output == new_output)
+		return;
+	spin_lock_irqsave(&e900_hdr_lock, irqflags);
+	if (old_output && !new_output) {
+		cancelled = e900_hdr_saw_off || e900_hdr_pending;
+		e900_hdr_clear_locked();
+		if (active_frame && mode != VMODE_NULL && mode != VMODE_INVALID) {
+			e900_hdr_saw_off = true;
+			e900_hdr_session = session;
+			e900_hdr_mode = mode;
+			e900_hdr_deadline = jiffies + 5 * HZ;
+			e900_hdr_generation++;
+		}
+	} else if (!old_output && new_output) {
+		if (e900_hdr_saw_off && active_frame &&
+		    e900_hdr_session == session && e900_hdr_mode == mode &&
+		    time_before(jiffies, e900_hdr_deadline)) {
+			e900_hdr_saw_off = false;
+			e900_hdr_pending = true;
+			e900_hdr_requests++;
+			requested = true;
+		} else {
+			cancelled = e900_hdr_saw_off || e900_hdr_pending;
+			e900_hdr_clear_locked();
+		}
+	}
+	generation = e900_hdr_generation;
+	spin_unlock_irqrestore(&e900_hdr_lock, irqflags);
+	if (cancelled)
+		e900_hdr_log("cancel", generation);
+	if (requested)
+		e900_hdr_log("request", generation);
+}
+EXPORT_SYMBOL(e900_hdr_recovery_edge);
+
+static bool e900_hdr_recovery_consume(struct vframe_s *vf,
+				     struct vinfo_s *vinfo, enum vd_path_e vd_path)
+{
+	unsigned long irqflags;
+	bool consumed = false, cancelled = false;
+	bool layer_on = get_video_enabled();
+	bool dolby_on = is_dolby_vision_on();
+	u32 session = e900_hdr_recovery_video_session();
+	u32 generation;
+
+	if (vd_path != VD1_PATH || !is_meson_gxlx2_cpu() ||
+	    !READ_ONCE(gxlx2_hdr_recovery))
+		return false;
+	spin_lock_irqsave(&e900_hdr_lock, irqflags);
+	if (e900_hdr_pending) {
+		if (e900_hdr_session != session ||
+		    e900_hdr_mode != vinfo->mode ||
+		    time_after_eq(jiffies, e900_hdr_deadline)) {
+			cancelled = true;
+			e900_hdr_clear_locked();
+		} else if (vf && vf != &fake_vframe &&
+			   layer_on && !dolby_on) {
+			e900_hdr_pending = false;
+			e900_hdr_consumed++;
+			consumed = true;
+		}
+	}
+	generation = e900_hdr_generation;
+	spin_unlock_irqrestore(&e900_hdr_lock, irqflags);
+	if (cancelled)
+		e900_hdr_log("cancel", generation);
+	if (consumed)
+		e900_hdr_log("consume", generation);
+	return consumed;
+}
