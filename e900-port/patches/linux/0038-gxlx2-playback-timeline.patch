+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef E900_PLAYBACK_TRACE_H
+#define E900_PLAYBACK_TRACE_H
+#include <linux/jiffies.h>
+/* Separate from 0035's nine-column submit trace. Intent/prepare/IRQ/read
+ * remain distinct; an IRQ is not proof of pixel output. No MMIO under lock.
+ */
+#define E900_PLAYBACK_CAP 4096
+#define E900_PLAYBACK_PAGE 8
+struct e900_playback_row {
+	u64 stamp;
+	u32 source, kind, session, phase, batch, handle, reg, value, aux;
+};
+static struct e900_playback_row e900_playback_rows[E900_PLAYBACK_CAP];
+static DEFINE_SPINLOCK(e900_playback_lock);
+static unsigned int e900_playback_status, e900_playback_generation;
+static unsigned int e900_playback_count, e900_playback_overflow;
+static unsigned int e900_playback_page, e900_playback_phase;
+static u32 e900_playback_session, e900_playback_batch;
+static u32 e900_playback_batch_floor;
+static unsigned int e900_playback_samples;
+static u32 e900_playback_normal_pending[RDMA_NUM];
+
+/* Caller holds trace lock. A full ring freezes with an explicit overflow. */
+static void e900_playback_add(u32 source, u32 kind, u32 session,
+			      u32 batch, u32 handle, u32 reg, u32 value, u32 aux)
+{
+	struct e900_playback_row *r;
+
+	if (e900_playback_status != 1)
+		return;
+	if (e900_playback_count == E900_PLAYBACK_CAP) {
+		e900_playback_overflow = 1;
+		e900_playback_status = 2;
+		return;
+	}
+	r = &e900_playback_rows[e900_playback_count++];
+	r->stamp = get_jiffies_64();
+	r->source = source;
+	r->kind = kind;
+	r->session = session ? session : e900_playback_session;
+	r->phase = e900_playback_phase;
+	r->batch = batch;
+	r->handle = handle;
+	r->reg = reg;
+	r->value = value;
+	r->aux = aux;
+}
+
+void e900_playback_note(u32 source, u32 kind, u32 session,
+			 u32 batch, u32 handle, u32 reg, u32 value, u32 aux)
+{
+	unsigned long flags;
+
+	if (!is_meson_gxlx2_cpu() || READ_ONCE(e900_playback_status) != 1)
+		return;
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	if (batch && batch <= e900_playback_batch_floor)
+		goto out;
+	if (source == 1 && session)
+		e900_playback_session = session;
+	e900_playback_add(source, kind, session, batch, handle, reg, value, aux);
+out:
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+}
+EXPORT_SYMBOL(e900_playback_note);
+
+u32 e900_playback_begin(u32 source, u32 handle, u32 trigger, u32 total)
+{
+	unsigned long flags;
+	u32 batch = 0;
+
+	if (!is_meson_gxlx2_cpu() || READ_ONCE(e900_playback_status) != 1)
+		return 0;
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	if (e900_playback_status == 1) {
+		if (e900_playback_count == E900_PLAYBACK_CAP) {
+			e900_playback_overflow = 1;
+			e900_playback_status = 2;
+			goto out;
+		}
+		batch = ++e900_playback_batch;
+		if (!batch)
+			batch = ++e900_playback_batch;
+		e900_playback_add(source, 3, 0, batch, handle, 0, trigger, total);
+	}
+out:
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+	return batch;
+}
+EXPORT_SYMBOL(e900_playback_begin);
+
+bool e900_playback_active(void)
+{
+	return is_meson_gxlx2_cpu() &&
+		READ_ONCE(e900_playback_status) == 1;
+}
+EXPORT_SYMBOL(e900_playback_active);
+
+bool e900_playback_batch_valid(u32 batch)
+{
+	return batch && READ_ONCE(e900_playback_status) == 1 &&
+		batch > READ_ONCE(e900_playback_batch_floor);
+}
+EXPORT_SYMBOL(e900_playback_batch_valid);
+
+bool e900_playback_sample_available(void)
+{
+	return READ_ONCE(e900_playback_status) == 1 &&
+		READ_ONCE(e900_playback_samples) < 16;
+}
+EXPORT_SYMBOL(e900_playback_sample_available);
+
+bool e900_playback_sample_take(void)
+{
+	unsigned long flags;
+	bool take = false;
+
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	if (e900_playback_status == 1 && e900_playback_samples < 16) {
+		e900_playback_samples++;
+		take = true;
+	}
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+	return take;
+}
+EXPORT_SYMBOL(e900_playback_sample_take);
+
+/* The ordinary manager's existing prepare/end hooks call these independently
+ * of whether the older submit recorder is armed. */
+static void e900_playback_normal_table(int handle, int trigger,
+				       const u32 *table, int count)
+{
+	u32 batch, old;
+	unsigned int i, selected = 0;
+
+	if (!is_meson_gxlx2_cpu() || READ_ONCE(e900_playback_status) != 1 ||
+	    handle <= 0 || handle >= RDMA_NUM || count <= 0)
+		return;
+	for (i = 0; i < (unsigned int)count; i++)
+		selected += e900_playback_selected(table[i * 2]);
+	old = xchg(&e900_playback_normal_pending[handle], 0);
+	if (old)
+		e900_playback_note(2, 6, 0, old, handle, 0, 5, 0);
+	if (!selected)
+		return;
+	batch = e900_playback_begin(2, handle, trigger, count);
+	if (!batch)
+		return;
+	for (i = 0; i < (unsigned int)count; i++)
+		if (e900_playback_selected(table[i * 2]))
+			e900_playback_note(2, 4, 0, batch, handle,
+				table[i * 2], table[i * 2 + 1], i);
+	{
+		unsigned long flags;
+
+		spin_lock_irqsave(&e900_playback_lock, flags);
+		if (e900_playback_status == 1 &&
+		    batch > e900_playback_batch_floor)
+			e900_playback_normal_pending[handle] = batch;
+		spin_unlock_irqrestore(&e900_playback_lock, flags);
+	}
+}
+
+static void e900_playback_normal_end(int handle, u32 status, u32 kind)
+{
+	u32 batch;
+
+	if (!is_meson_gxlx2_cpu() || READ_ONCE(e900_playback_status) != 1 ||
+	    handle <= 0 || handle >= RDMA_NUM)
+		return;
+	batch = xchg(&e900_playback_normal_pending[handle], 0);
+	if (batch)
+		e900_playback_note(2, kind == 2 ? 5 : 6, 0, batch,
+				   handle, 0, status, kind);
+}
+
+static int e900_playback_scan_set(const char *s, const struct kernel_param *kp)
+{
+	unsigned int command;
+	unsigned long flags;
+	int ret = kstrtouint(s, 0, &command);
+
+	(void)kp;
+	if (ret)
+		return ret;
+	if (command > 1)
+		return -EINVAL;
+	if (!is_meson_gxlx2_cpu())
+		return -ENODEV;
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	if (command) {
+		if (e900_playback_status == 1) {
+			ret = -EBUSY;
+			goto out;
+		}
+		e900_playback_generation++;
+		e900_playback_count = e900_playback_overflow = 0;
+		e900_playback_page = e900_playback_samples = 0;
+		e900_playback_batch_floor = e900_playback_batch;
+		memset(e900_playback_normal_pending, 0,
+		       sizeof(e900_playback_normal_pending));
+		e900_playback_status = 1;
+		e900_playback_add(1, 1, 0, 0, 0, 0, e900_playback_phase, 0);
+	} else {
+		e900_playback_status = 2;
+	}
+out:
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+	return ret;
+}
+
+static int e900_playback_scan_get(char *buf, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	int n;
+
+	(void)kp;
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	n = scnprintf(buf, PAGE_SIZE,
+		"generation=%u status=%u count=%u capacity=%u overflow=%u phase=%u\n",
+		e900_playback_generation, e900_playback_status,
+		e900_playback_count, E900_PLAYBACK_CAP,
+		e900_playback_overflow, e900_playback_phase);
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+	return n;
+}
+
+static int e900_playback_phase_set(const char *s, const struct kernel_param *kp)
+{
+	unsigned int phase;
+	unsigned long flags;
+	int ret = kstrtouint(s, 0, &phase);
+
+	(void)kp;
+	if (ret)
+		return ret;
+	if (phase < 1 || phase > 3)
+		return -EINVAL;
+	if (!is_meson_gxlx2_cpu())
+		return -ENODEV;
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	e900_playback_phase = phase;
+	e900_playback_add(1, 1, 0, 0, 0, 0, phase, 0);
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+	return 0;
+}
+
+static int e900_playback_phase_get(char *buf, const struct kernel_param *kp)
+{
+	(void)kp;
+	return scnprintf(buf, PAGE_SIZE, "%u\n", READ_ONCE(e900_playback_phase));
+}
+
+static int e900_playback_data_get(char *buf, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	unsigned int i, begin;
+	int n = 0;
+
+	(void)kp;
+	spin_lock_irqsave(&e900_playback_lock, flags);
+	if (e900_playback_status == 1) {
+		n = -EBUSY;
+		goto out;
+	}
+	if (e900_playback_page >= E900_PLAYBACK_CAP / E900_PLAYBACK_PAGE) {
+		n = -EINVAL;
+		goto out;
+	}
+	begin = e900_playback_page * E900_PLAYBACK_PAGE;
+	for (i = begin; i < e900_playback_count &&
+	     i < begin + E900_PLAYBACK_PAGE; i++) {
+		const struct e900_playback_row *r = &e900_playback_rows[i];
+
+		n += scnprintf(buf + n, PAGE_SIZE - n,
+			"%u %u %llx %x %x %x %x %x %x %x %x %x\n",
+			i, e900_playback_generation,
+			(unsigned long long)r->stamp,
+			r->source, r->kind, r->session, r->phase,
+			r->batch, r->handle, r->reg, r->value, r->aux);
+	}
+out:
+	spin_unlock_irqrestore(&e900_playback_lock, flags);
+	return n;
+}
+
+static const struct kernel_param_ops e900_playback_scan_ops = {
+	.set = e900_playback_scan_set, .get = e900_playback_scan_get,
+};
+static const struct kernel_param_ops e900_playback_phase_ops = {
+	.set = e900_playback_phase_set, .get = e900_playback_phase_get,
+};
+static const struct kernel_param_ops e900_playback_data_ops = {
+	.get = e900_playback_data_get,
+};
+module_param_cb(gxlx2_playback_scan, &e900_playback_scan_ops, NULL, 0600);
+module_param_cb(gxlx2_playback_phase, &e900_playback_phase_ops, NULL, 0600);
+module_param_named(gxlx2_playback_page, e900_playback_page, uint, 0600);
+module_param_cb(gxlx2_playback_data, &e900_playback_data_ops, NULL, 0400);
+#endif
