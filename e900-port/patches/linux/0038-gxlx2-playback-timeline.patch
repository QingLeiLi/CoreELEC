+/* Playback timeline source/kind and lifecycle code map (0038). */
+#define E900_PB_LIFE 1
+#define E900_PB_NORMAL_RDMA 2
+#define E900_PB_OSD_RDMA 3
+#define E900_PB_DIRECT 4
+#define E900_PB_SAFE_READ 5
+#define E900_PB_MARKER 1
+#define E900_PB_STATE 2
+#define E900_PB_PREPARE 3
+#define E900_PB_WORD 4
+#define E900_PB_IRQ 5
+#define E900_PB_CANCEL 6
+#define E900_PB_READ 7
+#define E900_PB_PROVIDER 1
+#define E900_PB_DISABLE 2
+#define E900_PB_FIRST_FRAME 3
+#define E900_PB_LAYER_SWITCH 4
+#define E900_PB_BLEND_STATE 5
+#define E900_PB_PPS 6
+#define E900_PB_CSC_POST 7
+#define E900_PB_HDR_REQUEST 8
+#define E900_PB_HDR_SUBMITTED 9
+#define E900_PB_HDR_DISABLED 10
+static inline bool e900_playback_selected(u32 reg)
+{
+	return (reg >= 0x1a00 && reg <= 0x1aff) ||
+		(reg >= 0x1d00 && reg <= 0x1dff) ||
+		(reg >= 0x3800 && reg <= 0x38ff) ||
+		(reg >= 0x3d60 && reg <= 0x3d6f);
+}
+static inline bool e900_playback_direct_selected(u32 reg)
+{
+	return e900_playback_selected(reg);
+}
+#if IS_REACHABLE(CONFIG_AMLOGIC_MEDIA_RDMA)
+void e900_playback_note(u32 source, u32 kind, u32 session,
+			 u32 batch, u32 handle, u32 reg, u32 value, u32 aux);
+u32 e900_playback_begin(u32 source, u32 handle, u32 trigger, u32 total);
+bool e900_playback_active(void);
+bool e900_playback_batch_valid(u32 batch);
+bool e900_playback_sample_available(void);
+bool e900_playback_sample_take(void);
+#else
+static inline void e900_playback_note(u32 source, u32 kind, u32 session,
+			 u32 batch, u32 handle, u32 reg, u32 value, u32 aux) { (void)source; (void)kind; (void)session; (void)batch; (void)handle; (void)reg; (void)value; (void)aux; }
+static inline u32 e900_playback_begin(u32 source, u32 handle,
+				      u32 trigger, u32 total) { (void)source; (void)handle; (void)trigger; (void)total; return 0; }
+static inline bool e900_playback_active(void) { return false; }
+static inline bool e900_playback_batch_valid(u32 batch) { (void)batch; return false; }
+static inline bool e900_playback_sample_available(void) { return false; }
+static inline bool e900_playback_sample_take(void) { return false; }
+#endif
+
