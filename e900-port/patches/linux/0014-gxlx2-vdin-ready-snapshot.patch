+#ifdef CONFIG_CMA
+struct e900_vdin_snapshot_header {
+	char magic[8];
+	__le32 version, header_bytes, width, height, format_convert;
+	__le32 active_row_bytes, source_stride, frame_index, bitdepth, flags;
+	__le64 frame_timestamp, sample_jiffies, completion_count, payload_bytes;
+};
+
+/* Returns a private CPU copy; no borrowed vframe or device pointer escapes. */
+static int e900_vdin_snapshot_copy(struct vdin_dev_s *devp,
+				  void **result, size_t *result_size)
+{
+	struct e900_vdin_snapshot_header *header;
+	struct vf_entry *vfe = NULL;
+	void *packet = NULL, *base;
+	unsigned int rows, stride, active, index = 0, row;
+	unsigned long flags, deadline;
+	size_t payload, slot;
+	int ret, sync_ret;
+	bool cpu_owned = false;
+
+	BUILD_BUG_ON(sizeof(struct e900_vdin_snapshot_header) != 80);
+	*result = NULL;
+	*result_size = 0;
+	if (!is_meson_gxlx2_cpu() || devp->index != 1)
+		return -EOPNOTSUPP;
+	/* A trylock avoids deadlock against remove waiting for this sysfs call. */
+	if (!device_trylock(&devp->this_pdev->dev))
+		return -EBUSY;
+	ret = mutex_lock_interruptible(&devp->fe_lock);
+	if (ret)
+		goto out_device;
+	ret = -EIO;
+	if (devp->pause_dec)
+		goto out_unlock;
+	ret = -EOPNOTSUPP;
+	if (!(devp->flags & VDIN_FLAG_DEC_STARTED) ||
+	    !(devp->flags & VDIN_FLAG_V4L2_DEBUG) ||
+	    (devp->flags & (VDIN_FLAG_SUSPEND | VDIN_FLAG_RDMA_ENABLE)) ||
+	    devp->rdma_enable || devp->afbce_mode ||
+	    devp->work_mode != VDIN_WORK_MD_E900_CAPTURE ||
+	    devp->source_bitdepth != 8 || !devp->e900_dma_mapped ||
+	    !devp->cma_mem_alloc || !devp->venc_pages ||
+	    !devp->fmt_info_p ||
+	    devp->fmt_info_p->scan_mode != TVIN_SCAN_MODE_PROGRESSIVE ||
+	    devp->matrix_pattern_mode || devp->secure_en || devp->mem_protected) {
+		pr_err("e900-snapshot: unsupported state flags=%x rdma=%u depth=%u mapped=%u allocated=%u\n",
+		       (unsigned int)devp->flags, devp->rdma_enable,
+		       devp->source_bitdepth, devp->e900_dma_mapped,
+		       devp->cma_mem_alloc);
+		goto out_unlock;
+	}
+	switch (devp->format_convert) {
+	case VDIN_FORMAT_CONVERT_YUV_YUV444:
+	case VDIN_FORMAT_CONVERT_YUV_RGB:
+	case VDIN_FORMAT_CONVERT_RGB_YUV444:
+	case VDIN_FORMAT_CONVERT_RGB_RGB:
+		break;
+	default:
+		goto out_unlock;
+	}
+	rows = devp->canvas_h;
+	stride = devp->canvas_w;
+	active = devp->canvas_active_w;
+	ret = -ERANGE;
+	if (!rows || rows > 1080 || !stride || !active ||
+	    active > 1920 * 3 || active % 3 || active > stride ||
+	    rows > devp->frame_size / stride) {
+		pr_err("e900-snapshot: invalid layout rows=%u stride=%u active=%u slot=%u\n",
+		       rows, stride, active, devp->frame_size);
+		goto out_unlock;
+	}
+	payload = (size_t)rows * active;
+	packet = vmalloc(sizeof(*header) + payload);
+	if (!packet) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+	deadline = jiffies + msecs_to_jiffies(2000);
+	for (;;) {
+		spin_lock_irqsave(&devp->isr_lock, flags);
+		if (devp->vfp->pool_flag & VDIN_VF_POOL_FREEZE) {
+			ret = -EBUSY;
+		} else {
+			vfe = receiver_vf_get(devp->vfp);
+			ret = vfe ? 0 : -EAGAIN;
+			if (vfe) {
+				index = vfe->vf.index;
+				if (!(vfe->flag & VF_FLAG_NORMAL_FRAME) ||
+				    (vfe->flag & VF_FLAG_FREEZED_FRAME) ||
+				    index >= VDIN_CANVAS_MAX_CNT ||
+				    index >= devp->vfmem_max_cnt ||
+				    (devp->curr_wr_vfe &&
+				     devp->curr_wr_vfe->vf.index == index) ||
+				    (devp->last_wr_vfe &&
+				     devp->last_wr_vfe->vf.index == index)) {
+					/* Restore original queue ownership; never read it. */
+					if (vfe->flag & VF_FLAG_FREEZED_FRAME)
+						receiver_vf_put(&vfe->vf, devp->vfp);
+					else
+						provider_vf_put(vfe, devp->vfp);
+					vfe = NULL;
+					ret = -EIO;
+				}
+			}
+		}
+		spin_unlock_irqrestore(&devp->isr_lock, flags);
+		if (ret != -EAGAIN)
+			break;
+		if (time_after_eq(jiffies, deadline)) {
+			ret = -ETIMEDOUT;
+			pr_err("e900-snapshot: no ready frame within 2000 ms\n");
+			break;
+		}
+		if (msleep_interruptible(20)) {
+			ret = -ERESTARTSYS;
+			break;
+		}
+	}
+	if (ret)
+		goto out_free;
+	ret = e900_vdin_dma_sync_frame(devp, index, true);
+	if (ret)
+		goto out_frame;
+	cpu_owned = true;
+	base = page_address(devp->venc_pages);
+	if (!base) {
+		ret = -EFAULT;
+		goto out_frame;
+	}
+	slot = (size_t)index * devp->frame_size;
+	header = packet;
+	memset(header, 0, sizeof(*header));
+	memcpy(header->magic, "E9VDIN1", 8);
+	header->version = cpu_to_le32(1);
+	header->header_bytes = cpu_to_le32(sizeof(*header));
+	header->width = cpu_to_le32(active / 3);
+	header->height = cpu_to_le32(rows);
+	header->format_convert = cpu_to_le32(devp->format_convert);
+	header->active_row_bytes = cpu_to_le32(active);
+	header->source_stride = cpu_to_le32(stride);
+	header->frame_index = cpu_to_le32(index);
+	header->bitdepth = cpu_to_le32(8);
+	/* Software ready-queue / DMA-sync checks, not an HDMI-valid assertion. */
+	header->flags = cpu_to_le32(3);
+	header->frame_timestamp = cpu_to_le64(vfe->vf.timestamp);
+	header->sample_jiffies = cpu_to_le64(jiffies_64);
+	header->completion_count = cpu_to_le64(devp->frame_cnt);
+	header->payload_bytes = cpu_to_le64(payload);
+	for (row = 0; row < rows; row++)
+		memcpy((char *)packet + sizeof(*header) + row * active,
+		       (char *)base + slot + (size_t)row * stride, active);
+	ret = 0;
+out_frame:
+	if (cpu_owned) {
+		sync_ret = e900_vdin_dma_sync_frame(devp, index, false);
+		if (sync_ret) {
+			/* Invariant failure: don't hand CPU-owned bytes to DMA. */
+			pr_err("e900-snapshot: DMA handback failed %d; stop capture\n",
+			       sync_ret);
+			ret = sync_ret;
+			devp->pause_dec = 1;
+			vfe = NULL;
+		}
+	}
+	if (vfe)
+		receiver_vf_put(&vfe->vf, devp->vfp);
+	if (!ret) {
+		*result = packet;
+		*result_size = sizeof(*header) + payload;
+		packet = NULL;
+	}
+out_free:
+	vfree(packet);
+out_unlock:
+	mutex_unlock(&devp->fe_lock);
+out_device:
+	device_unlock(&devp->this_pdev->dev);
+	return ret;
+}
+
+static int e900_vdin_snapshot_save(struct vdin_dev_s *devp, const char *path)
+{
+	struct file *file;
+	void *packet;
+	size_t size, written = 0;
+	loff_t position = 0;
+	mm_segment_t previous_fs;
+	ssize_t count;
+	int ret, close_ret;
+
+	ret = e900_vdin_snapshot_copy(devp, &packet, &size);
+	if (ret)
+		return ret;
+	/* Device/pool ownership is already released before filesystem I/O. */
+	file = filp_open(path, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 0600);
+	if (IS_ERR(file)) {
+		ret = PTR_ERR(file);
+		goto out_free;
+	}
+	previous_fs = get_fs();
+	set_fs(KERNEL_DS);
+	while (written < size) {
+		count = vfs_write(file, (char *)packet + written,
+				  size - written, &position);
+		if (count <= 0) {
+			ret = count < 0 ? count : -EIO;
+			break;
+		}
+		written += count;
+	}
+	set_fs(previous_fs);
+	if (!ret)
+		ret = vfs_fsync(file, 0);
+	close_ret = filp_close(file, NULL);
+	if (!ret)
+		ret = close_ret;
+out_free:
+	vfree(packet);
+	return ret;
+}
