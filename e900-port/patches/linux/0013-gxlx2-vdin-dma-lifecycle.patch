+/* Diagnostic mapping only: caller must hold fe_lock and own any read frame. */
+static int e900_vdin_dma_map(struct vdin_dev_s *devp)
+{
+	dma_addr_t address;
+	struct device *dev = &devp->this_pdev->dev;
+
+	if (!is_meson_gxlx2_cpu() || devp->index != 1)
+		return 0;
+	if (devp->e900_dma_mapped || devp->cma_config_flag ||
+	    !devp->venc_pages || !devp->mem_size || devp->afbce_mode ||
+	    PageHighMem(devp->venc_pages))
+		return -EOPNOTSUPP;
+#ifdef CONFIG_AMLOGIC_TEE
+	if (devp->secure_en || devp->mem_protected)
+		return -EOPNOTSUPP;
+#endif
+	address = dma_map_page(dev, devp->venc_pages, 0,
+			       devp->mem_size, DMA_FROM_DEVICE);
+	if (dma_mapping_error(dev, address))
+		return -EIO;
+	/* Canvas still uses physical addresses; reject translation/bounce paths. */
+	if (address != devp->mem_start) {
+		dma_unmap_page(dev, address, devp->mem_size, DMA_FROM_DEVICE);
+		return -EOPNOTSUPP;
+	}
+	devp->e900_dma_address = address;
+	devp->e900_dma_size = devp->mem_size;
+	devp->e900_dma_mapped = true;
+	return 0;
+}
+
+static void e900_vdin_dma_unmap(struct vdin_dev_s *devp)
+{
+	if (!devp->e900_dma_mapped)
+		return;
+	dma_unmap_page(&devp->this_pdev->dev, devp->e900_dma_address,
+		       devp->e900_dma_size, DMA_FROM_DEVICE);
+	devp->e900_dma_mapped = false;
+	devp->e900_dma_address = 0;
+	devp->e900_dma_size = 0;
+}
+
+/* No arbitrary-address access: only a bounded frame slot in this mapped pool. */
+int e900_vdin_dma_sync_frame(struct vdin_dev_s *devp,
+			    unsigned int index, bool for_cpu)
+{
+	size_t offset;
+
+	if (!is_meson_gxlx2_cpu() || devp->index != 1 ||
+	    !devp->e900_dma_mapped || !devp->cma_mem_alloc ||
+	    !devp->frame_size || index >= VDIN_CANVAS_MAX_CNT ||
+	    index >= devp->vfmem_max_cnt)
+		return -EINVAL;
+	if (index > devp->e900_dma_size / devp->frame_size)
+		return -ERANGE;
+	offset = (size_t)index * devp->frame_size;
+	if (offset > devp->e900_dma_size ||
+	    devp->frame_size > devp->e900_dma_size - offset ||
+	    devp->vfmem_start[index] < devp->mem_start ||
+	    devp->vfmem_start[index] - devp->mem_start != offset)
+		return -ERANGE;
+	if (for_cpu)
+		dma_sync_single_range_for_cpu(&devp->this_pdev->dev,
+			devp->e900_dma_address, offset, devp->frame_size,
+			DMA_FROM_DEVICE);
+	else
+		dma_sync_single_range_for_device(&devp->this_pdev->dev,
+			devp->e900_dma_address, offset, devp->frame_size,
+			DMA_FROM_DEVICE);
+	return 0;
+}
