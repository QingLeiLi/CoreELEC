+/* E900 stage probes: observation only, no display writes or frame ownership. */
+static unsigned int gxlx2_stage_samples;
+static unsigned int e900_stage_input_left;
+static unsigned int e900_stage_epoch;
+
+static int e900_stage_samples_set(const char *value,
+				  const struct kernel_param *kp)
+{
+	unsigned int n;
+	int ret = kstrtouint(value, 0, &n);
+
+	if (ret)
+		return ret;
+	if (n > 8)
+		return -ERANGE;
+	/* Each hook has its own bounded budget; zero disables both. */
+	WRITE_ONCE(e900_stage_input_left, n);
+	WRITE_ONCE(e900_stage_epoch, READ_ONCE(e900_stage_epoch) + 1);
+	WRITE_ONCE(*(unsigned int *)kp->arg, n);
+	return 0;
+}
+
+static const struct kernel_param_ops e900_stage_sample_ops = {
+	.set = e900_stage_samples_set,
+	.get = param_get_uint,
+};
+module_param_cb(gxlx2_stage_samples, &e900_stage_sample_ops,
+		&gxlx2_stage_samples, 0644);
+MODULE_PARM_DESC(gxlx2_stage_samples,
+	"GXLX2 legacy H264 stage observations, 0=off, 1..8 bounded samples");
+
+static bool e900_stage_take(unsigned int *budget)
+{
+	unsigned int n;
+
+	if (!is_meson_gxlx2_cpu())
+		return false;
+	n = READ_ONCE(*budget);
+	return n && cmpxchg(budget, n, n - 1) == n;
+}
+
+static void e900_stage_init(const char *phase)
+{
+	if (!is_meson_gxlx2_cpu())
+		return;
+	/* These queries inspect software only, including before bus publication. */
+	pr_info("e900-stage init=%s ready_vc=%u ready_hhi=%u ready_dmc=%u drop_vc=%u drop_hhi=%u drop_dmc=%u\n",
+		phase, codec_reg_bus_ready(IO_VC_BUS),
+		codec_reg_bus_ready(IO_HHI_BUS),
+		codec_reg_bus_ready(IO_DMC_BUS),
+		codec_reg_bus_dropped_writes(IO_VC_BUS),
+		codec_reg_bus_dropped_writes(IO_HHI_BUS),
+		codec_reg_bus_dropped_writes(IO_DMC_BUS));
+}
+
+static void e900_stage_input(u8 layer_id, struct vframe_s *vf,
+			     struct video_layer_s *layer, bool update_mif)
+{
+	if (layer_id || !e900_stage_take(&e900_stage_input_left))
+		return;
+	/* Called while the normal display path owns vf; never retain its pointer. */
+	pr_info("e900-stage epoch=%u input idx=%u pts=%u size=%ux%u type=%x depth=%x src_canvas=%x dst_canvas=%x update_mif=%u swap_vd2=%u\n",
+		READ_ONCE(e900_stage_epoch), vf->index, vf->pts,
+		vf->width, vf->height, vf->type, vf->bitdepth,
+		vf->canvas0Addr, layer->disp_canvas[layer->cur_canvas_id][0],
+		update_mif, layer->vd1_vd2_mux);
+}
+
+static void e900_stage_output(u32 blend_requested)
+{
+	struct video_layer_s *layer = &vd_layer[0];
+	struct hw_vd_reg_s *mif = &layer->vd_mif_reg;
+	struct vframe_s *vf = layer->dispbuf;
+	unsigned int epoch, gen, canvas, fmt, off = cur_dev->vpp_off;
+
+	if (!e900_stage_take(&gxlx2_stage_samples))
+		return;
+	epoch = READ_ONCE(e900_stage_epoch);
+	if (layer->switch_vf && layer->vf_ext)
+		vf = layer->vf_ext;
+	/* Only the already selected legacy bank with active uncompressed video.
+	 * No arbitrary register selector, powered-down read or G12-bank probing.
+	 */
+	if (!legacy_vpp || gxlx2_g12_mif || layer->vd1_vd2_mux ||
+	    !vf || !layer->enabled || (vf->type & VIDTYPE_COMPRESS) ||
+	    !codec_reg_bus_ready(IO_VC_BUS) ||
+	    mif->vd_if0_gen_reg != 0x1a50 ||
+	    mif->vd_if0_canvas0 != 0x1a51 ||
+	    mif->viu_vd_fmt_ctrl != 0x1a68 || off) {
+		pr_info("e900-stage epoch=%u output_skipped active=%u frame=%u legacy=%u g12_mif=%u swap_vd2=%u bus=%u\n",
+			epoch, layer->enabled, !!vf, legacy_vpp,
+			gxlx2_g12_mif, layer->vd1_vd2_mux,
+			codec_reg_bus_ready(IO_VC_BUS));
+		return;
+	}
+	/* READ_VCBUS_REG is live hardware; VSYNC_RD is the RDMA-aware view.
+	 * Current vsync's submissions may not have latched: compare a sequence,
+	 * never classify a single shadow/live difference as a hardware failure.
+	 */
+	gen = READ_VCBUS_REG(mif->vd_if0_gen_reg);
+	canvas = READ_VCBUS_REG(mif->vd_if0_canvas0);
+	fmt = READ_VCBUS_REG(mif->viu_vd_fmt_ctrl);
+	pr_info("e900-stage epoch=%u mif idx=%u pts=%u live_gen=%x live_canvas=%x live_fmt=%x shadow_gen=%x shadow_canvas=%x shadow_fmt=%x\n",
+		epoch, vf->index, vf->pts, gen, canvas, fmt,
+		VSYNC_RD_MPEG_REG(mif->vd_if0_gen_reg),
+		VSYNC_RD_MPEG_REG(mif->vd_if0_canvas0),
+		VSYNC_RD_MPEG_REG(mif->viu_vd_fmt_ctrl));
+	pr_info("e900-stage epoch=%u layout gen2=%x gen3=%x fifo=%x shadow_gen2=%x shadow_gen3=%x\n",
+		epoch, READ_VCBUS_REG(mif->vd_if0_gen_reg2),
+		READ_VCBUS_REG(mif->vd_if0_gen_reg3),
+		READ_VCBUS_REG(mif->vd_if0_luma_fifo_size),
+		VSYNC_RD_MPEG_REG(mif->vd_if0_gen_reg2),
+		VSYNC_RD_MPEG_REG(mif->vd_if0_gen_reg3));
+	pr_info("e900-stage epoch=%u pipe luma_x=%x luma_y=%x sc=%x hphase=%x vphase=%x matrix=%x\n",
+		epoch, READ_VCBUS_REG(mif->vd_if0_luma_x0),
+		READ_VCBUS_REG(mif->vd_if0_luma_y0),
+		READ_VCBUS_REG(VPP_SC_MISC),
+		READ_VCBUS_REG(VPP_HSC_START_PHASE_STEP),
+		READ_VCBUS_REG(VPP_VSC_START_PHASE_STEP),
+		READ_VCBUS_REG(VPP_MATRIX_CTRL));
+	pr_info("e900-stage epoch=%u blend requested=%x live=%x shadow=%x post_h=%x post_v=%x drop_vc=%u\n",
+		epoch, blend_requested, READ_VCBUS_REG(VPP_MISC),
+		VSYNC_RD_MPEG_REG(VPP_MISC),
+		READ_VCBUS_REG(VPP_POSTBLEND_VD1_H_START_END),
+		READ_VCBUS_REG(VPP_POSTBLEND_VD1_V_START_END),
+		codec_reg_bus_dropped_writes(IO_VC_BUS));
+}
 
