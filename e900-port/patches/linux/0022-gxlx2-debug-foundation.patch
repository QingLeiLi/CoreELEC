+MODULE_PARM_DESC(gxlx2_debug_events, "E900 bounded lifecycle events: 0=off, 1..512"); \
+static noinline void e900_debug_event(const char *event, u32 a, u32 b, u32 c, u32 d) \
+{ \
+ unsigned int n; \
+ if (!is_meson_gxlx2_cpu()) return; \
+ n = READ_ONCE(gxlx2_debug_events); \
+ while (n) { \
+  unsigned int seen = cmpxchg(&gxlx2_debug_events, n, n - 1); \
+  if (seen == n) break; \
+  n = seen; \
+ } \
+ if (!n) return; \
+ pr_info("e900-debug channel=" channel " seq=%d event=%s a=%x b=%x c=%x d=%x caller=%pS\n", \
+  atomic_inc_return(&e900_debug_seq), event, a, b, c, d, __builtin_return_address(0)); \
