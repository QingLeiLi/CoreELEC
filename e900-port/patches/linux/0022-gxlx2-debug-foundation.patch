+#define E900_DEBUG_CHANNEL(channel) \
+static unsigned int gxlx2_debug_events; \
+static atomic_t e900_debug_seq = ATOMIC_INIT(0); \
+static int e900_debug_set(const char *s, const struct kernel_param *kp) \
+{ \
