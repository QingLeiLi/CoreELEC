+/* Source-level E900 diagnostic, enabled only for the board profile.
+ * The trace page is reserved separately from ramoops in its diagnostic DTB.
+ */
+extern u32 e900_virtual_boot_stage;
+static void __init e900_source_boot_trace(void)
+{
+	u32 __iomem *trace;
+	if (!of_machine_is_compatible("skyworth,e900v21c"))
+		return;
+	trace = early_ioremap(0x074ff000, 4096);
+	if (trace) {
+		writel(0xe9110004, trace);
+		early_iounmap(trace, 4096);
+	}
+	pr_notice("E900_TRACE: MMU virtual stage=%u; setup_arch completed; C startup reached\n",
+		  e900_virtual_boot_stage);
+}
+
 asmlinkage __visible void __init start_kernel(void)
 {
 	char *command_line;
@@ -512,6 +533,7 @@
 	page_address_init();
 	pr_notice("%s", linux_banner);
 	setup_arch(&command_line);
+	e900_source_boot_trace();
 	mm_init_cpumask(&init_mm);
 	setup_command_line(command_line);
 	setup_nr_cpu_ids();
