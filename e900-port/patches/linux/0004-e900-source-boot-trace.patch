--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -218,7 +218,20 @@
 	 *  x28        __create_page_tables()     callee preserved temp register
 	 *  x19/x20    __primary_switch()         callee preserved temp registers
 	 */
+/* E900 diagnostic trace in reserved normal RAM; MMU must be off.
+ * x16/x17 are scratch on the primary bootstrap path, x0..x3 stay intact.
+ */
+	.macro e900_boot_trace, stage
+	movz	x16, #0xf000
+	movk	x16, #0x074f, lsl #16
+	movz	w17, #\stage
+	movk	w17, #0xe911, lsl #16
+	str	w17, [x16]
+	dsb	sy
+	.endm
+
 ENTRY(stext)
+	e900_boot_trace 1
 	bl	preserve_boot_args
 	bl	el2_setup			// Drop to EL1, w0=cpu_boot_mode
 	adrp	x23, __PHYS_OFFSET
@@ -232,6 +245,7 @@
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+	e900_boot_trace 2
 	b	__primary_switch
 ENDPROC(stext)
 
@@ -426,6 +440,9 @@
  *   x0 = __PHYS_OFFSET
  */
 __primary_switched:
+	/* Virtual mapping is active; record in mapped .data, not physical RAM. */
+	mov	w16, #3
+	str_l	w16, e900_virtual_boot_stage, x17
 	adrp	x4, init_thread_union
 	add	sp, x4, #THREAD_SIZE
 	adr_l	x5, init_task
@@ -643,6 +660,9 @@
  * This is not in .bss, because we set it sufficiently early that the boot-time
  * zeroing of .bss would clobber it.
  */
+ENTRY(e900_virtual_boot_stage)
+	.long 0
+	.balign 8
 ENTRY(__boot_cpu_mode)
 	.long	BOOT_CPU_MODE_EL2
 	.long	BOOT_CPU_MODE_EL1
