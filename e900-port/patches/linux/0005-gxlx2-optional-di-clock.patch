Subject: [EXPERIMENTAL] avoid passing absent GXLX2 DI clkb as ERR_PTR

Matches the tested E900 boot guard for the observed -ENOENT clock lookup.
Valid clocks, deferred lookup and other SoCs retain their existing behavior.

diff --git a/drivers/amlogic/media/deinterlace/deinterlace.c b/drivers/amlogic/media/deinterlace/deinterlace.c
--- a/drivers/amlogic/media/deinterlace/deinterlace.c
+++ b/drivers/amlogic/media/deinterlace/deinterlace.c
@@ -9267,8 +9267,12 @@
 	#ifdef CLK_TREE_SUPPORT
 	pdev->vpu_clkb = clk_get(dev, "vpu_clkb_composite");
 
-	if (IS_ERR(pdev->vpu_clkb))
+	if (IS_ERR(pdev->vpu_clkb)) {
 		pr_err("%s: get vpu clkb gate error.\n", __func__);
+		/* P291 has the older GXL DI clock layout and no optional clkb. */
+		if (is_meson_gxlx2_cpu() && PTR_ERR(pdev->vpu_clkb) == -ENOENT)
+			pdev->vpu_clkb = NULL;
+	}
 	#endif
 }
 
