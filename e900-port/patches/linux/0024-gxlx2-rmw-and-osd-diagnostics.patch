Subject: [DIAGNOSTIC] fixed GEN3 RMW provenance and opt-in legacy OSD blender test

No new register reads. GEN3 intent/base/result budgets independent from IRQ logs.
OSD experiment default off, GXLX2 legacy OSD1 without AFBC only.

--- /dev/null
+++ b/include/linux/amlogic/media/registers/e900_gen3_debug.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef E900_GEN3_DEBUG_H
+#define E900_GEN3_DEBUG_H
+#include <linux/amlogic/media/registers/e900_debug.h>
+/* Expand after E900_DEBUG_CHANNEL. Independent budget: completion IRQ noise
+ * cannot consume the GEN3 investigation. Values are from existing operations;
+ * this helper never reads hardware, changes ordering, or accepts an address.
+ */
+#define E900_GEN3_RMW_CHANNEL(channel) \
+static unsigned int gxlx2_gen3_rmw_events; \
+module_param_cb(gxlx2_gen3_rmw_events, &e900_debug_ops, &gxlx2_gen3_rmw_events, 0600); \
+MODULE_PARM_DESC(gxlx2_gen3_rmw_events, "E900 fixed GEN3 RMW log budget 0..512; default off"); \
+static noinline void e900_gen3_rmw(u32 reg, int handle, int mode, u32 start, u32 len, \
+ u32 hardware, u32 base, u32 result, int source, void *caller) \
+{ \
+ unsigned int n; \
+ if (!is_meson_gxlx2_cpu() || reg != 0x1aa7) return; \
+ n = READ_ONCE(gxlx2_gen3_rmw_events); \
+ while (n) { \
+  unsigned int seen = cmpxchg(&gxlx2_gen3_rmw_events, n, n - 1); \
+  if (seen == n) break; \
+  n = seen; \
+ } \
+ if (!n) return; \
+ pr_info("e900-gen3 channel=" channel " handle=%d mode=%d start=%u len=%u hardware=%x base=%x result=%x source=%d caller=%pS\n", \
+ handle, mode, start, len, hardware, base, result, source, caller); \
+}
+#endif
