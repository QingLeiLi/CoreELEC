+ return is_meson_gxlx2_cpu() && READ_ONCE(gxlx2_osd_blender_only) &&
+  index == OSD1 && osd_hw.osd_meson_dev.osd_ver <= OSD_NORMAL &&
+  osd_hw.osd_meson_dev.afbc_type != MESON_AFBC &&
+  osd_hw.osd_meson_dev.afbc_type != MALI_AFBC;
+}
