+ * Not a proven fix. Disable the option only after unblanking OSD1.
+ */
+static bool gxlx2_osd_blender_only;
+module_param_named(gxlx2_osd_blender_only, gxlx2_osd_blender_only, bool, 0600);
+MODULE_PARM_DESC(gxlx2_osd_blender_only,
+ "Experimental GXLX2 legacy OSD1 disable via blender only; default off");
+static bool e900_keep_osd_fetch(u32 index)
